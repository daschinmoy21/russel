---
import TopBar from '../components/TopBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'Russel Dashboard', activePath = '/' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Russel Control Plane</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- FOUC prevention: apply a stored theme before paint (dark by default) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('russel-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (_) { /* storage blocked: keep dark */ }
      })();
    </script>
  </head>
  <body>
    <div class="app-container">
      <TopBar activePath={activePath} />
      <div class="main-layout">
        <main class="content-body">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
