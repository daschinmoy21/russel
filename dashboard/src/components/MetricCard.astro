---
interface Props {
  title: string;
  value: string;
  subtext: string;
  progressPercent?: number;
  accentColor?: string;
  trend?: 'up' | 'down' | 'neutral';
}

const {
  title,
  value,
  subtext,
  progressPercent,
  accentColor = 'var(--accent-primary)',
  trend,
} = Astro.props;

---

<div class="metric-card card-panel">
  <span class="metric-title">{title}</span>
  <div class="metric-value-row">
    <span class="metric-value">{value}</span>

  </div>
  <span class={`metric-subtext${trend === 'up' ? ' subtext-trend-up' : trend === 'down' ? ' subtext-trend-down' : ''}`}>{subtext}</span>
  {progressPercent !== undefined && progressPercent > 0 && (
    <div class="metric-progress-track">
      <div
        class="metric-progress-fill"
        style={`width: ${progressPercent}%; background-color: ${accentColor};`}
      ></div>
    </div>
  )}
</div>

<style>
  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem;
  }

  .metric-title {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .metric-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .metric-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .metric-trend {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .metric-trend.trend-up {
    color: var(--accent-green);
  }

  .metric-trend.trend-down {
    color: var(--accent-red);
  }

  .metric-subtext {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .metric-subtext.subtext-trend-up {
    color: var(--accent-green);
  }

  .metric-subtext.subtext-trend-down {
    color: var(--accent-red);
  }

  .metric-progress-track {
    width: 100%;
    height: 3px;
    background-color: var(--border-card);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 0.15rem;
  }

  .metric-progress-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.5s ease;
  }
</style>
