---
import type { FleetStatus, ServiceVM } from '../lib/api';
import { formatUptime, plural } from '../lib/api';

interface Props {
  status: FleetStatus;
  services: ServiceVM[];
}

const { status, services } = Astro.props;

const microvmCount = services.filter(s => s.runtime === 'microvm').length;
const containerCount = services.filter(s => s.runtime === 'container').length;
const total = Math.max(status.total_vms, services.length, 0);
const hasFleet = total > 0;

function pct(v: number, of: number): number {
  return of > 0 ? Math.round((v / of) * 100) : 0;
}

// Status rows share the fleet total; runtime rows share the service count.
const statusRows = [
  { id: 'barRunning', name: 'running', value: status.running_vms, of: total, tone: 'ok' },
  { id: 'barStopped', name: 'stopped', value: status.stopped_vms, of: total, tone: 'warn' },
  { id: 'barFailed', name: 'failed', value: status.failed_vms, of: total, tone: 'bad' },
];
const runtimeRows = [
  { id: 'barMicrovm', name: 'microvm', value: microvmCount, of: services.length },
  { id: 'barContainer', name: 'container', value: containerCount, of: services.length },
];

const sparks = [
  { key: 'Ep', name: 'endpoints', dashed: false },
  { key: 'Api', name: 'control plane', dashed: true },
  { key: 'Run', name: 'running', dashed: false },
];
---

<section class="block" id="fleetComposition">
  <div class="block-head">
    <h2 class="section-title">Composition</h2>
    {!hasFleet && <a href="/deploy" class="btn btn-sm panel-cta">deploy a service</a>}
  </div>

  {hasFleet ? null : (
    <p class="fleet-empty tree-row" role="status">
      <span class="muted">fleet is empty &middot; deploy a microVM or container to populate counts</span>
    </p>
  )}

  <div class="rows" id="compositionBars">
    {statusRows.map((r) => (
      <div class={`tree-row bar-row${r.value === 0 ? ' is-zero' : ''}`} id={r.id} data-of={r.of}>
        <span class="c-name">{r.name}</span>
        <span class="c-count bar-count">{r.value}</span>
        <span class="hbar" role="img" aria-label={`${r.name}: ${r.value} of ${r.of}`}>
          <span class="hbar-fill bar-fill" style={`width:${pct(r.value, r.of)}%`}></span>
        </span>
        <span class={`c-tone tone-${r.tone}`}>{r.tone === 'ok' ? 'ok' : r.tone === 'warn' ? 'idle' : 'err'}</span>
      </div>
    ))}
    <div class="rows-gap"></div>
    {runtimeRows.map((r) => (
      <div class={`tree-row bar-row${r.value === 0 ? ' is-zero' : ''}`} id={r.id} data-of={r.of}>
        <span class="c-name">{r.name}</span>
        <span class="c-count bar-count">{r.value}</span>
        <span class="hbar" role="img" aria-label={`${r.name}: ${r.value}`}>
          <span class="hbar-fill bar-fill" style={`width:${pct(r.value, r.of)}%`}></span>
        </span>
        <span class="c-tone muted">{r.name === 'microvm' ? 'cloud-hypervisor' : 'podman'}</span>
      </div>
    ))}
  </div>

  <p class="tree-row stats-line" id="fleetStatsRow">
    <span><span id="statRunning">{status.running_vms}</span> running</span>
    <span class="dot">&middot;</span>
    <span><span id="statStopped">{status.stopped_vms}</span> stopped</span>
    <span class="dot">&middot;</span>
    <span><span id="statFailed">{status.failed_vms}</span> failed</span>
    <span class="dot">&middot;</span>
    <span><span id="statMicrovm">{microvmCount}</span> <span class="stat-word" id="statMicrovmWord">{plural(microvmCount, 'microVM')}</span></span>
    <span class="dot">&middot;</span>
    <span><span id="statContainer">{containerCount}</span> <span class="stat-word" id="statContainerWord">{plural(containerCount, 'container')}</span></span>
    <span class="dot">&middot;</span>
    <span>max uptime <span id="statMaxUptime">{status.max_uptime_seconds > 0 ? formatUptime(status.max_uptime_seconds) : '—'}</span></span>
  </p>
</section>

<section class="block" id="endpointHealthSection">
  <div class="block-head">
    <h2 class="section-title">Latency</h2>
  </div>

  <p id="epChartEmpty" class="tree-row spark-empty">
    <span class="dots" aria-hidden="true"></span>
    <span class="muted">no samples yet &middot; browser probes of host ports + api</span>
  </p>

  <div class="rows" id="sparkRows" style="display:none">
    {sparks.map((s) => (
      <div class="tree-row spark-row" id={`sparkRow${s.key}`} style="display:none">
        <span class="c-name">{s.name}</span>
        <span class="c-count spark-value" id={`sparkVal${s.key}`}>—</span>
        <svg class="spark-svg" id={`sparkSvg${s.key}`} viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true">
          <path id={`sparkArea${s.key}`} class="spark-area" d=""/>
          <path
            id={`sparkLine${s.key}`}
            class="spark-line"
            fill="none"
            stroke-dasharray={s.dashed ? '4 3' : undefined}
            vector-effect="non-scaling-stroke"
            d=""
          />
        </svg>
        <span class="c-meta">
          <span class="spark-range" id={`sparkRange${s.key}`}></span>
          <span class="spark-sub" id={`sparkSub${s.key}`}></span>
        </span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-line {
    margin-top: 1.1rem;
    gap: 0.6rem;
    color: var(--text-muted);
  }

  .stats-line span span {
    color: var(--text-primary);
  }

  .stats-line .stat-word,
  .dot {
    color: var(--text-muted);
  }

  /* Empty rows recede so the non-zero counts carry the section. */
  .bar-row.is-zero {
    opacity: 0.45;
  }

  .fleet-empty {
    margin-bottom: 1rem;
  }

  .spark-empty {
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .dots {
    flex: 0 1 32rem;
    min-width: 6rem;
    align-self: center;
    background-image: radial-gradient(circle, var(--text-muted) 1px, transparent 1.2px);
    background-size: 12px 3px;
    background-repeat: repeat-x;
    height: 3px;
  }

  .spark-svg {
    display: block;
    width: 15rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .spark-line {
    stroke: var(--text-primary);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .spark-area {
    fill: var(--text-primary);
    opacity: 0.06;
  }

  .c-meta {
    display: inline-flex;
    gap: 1rem;
    color: var(--text-muted);
  }

</style>
