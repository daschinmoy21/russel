---
// Page heading. The connection status lives in the TopBar so every view
// shares one probe and one indicator.
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="page-header">
  <h1 class="page-title">{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.75rem;
    min-width: 0;
  }
</style>
