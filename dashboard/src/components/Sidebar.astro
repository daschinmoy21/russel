---
interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
---

<aside class="sidebar">
  <!-- Brand -->
  <div class="brand-row">
    <div class="brand-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
    </div>
    <span class="brand-name">Russel</span>
  </div>

  <!-- Workspace selector -->
  <div class="workspace-selector">
    <div class="ws-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="3"/>
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="9" y1="21" x2="9" y2="9"/>
      </svg>
    </div>
    <div class="ws-info">
      <span class="ws-title">Team Workspace</span>
      <span class="ws-subtitle">Control Plane</span>
    </div>
    <div class="ws-chevron">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M7 10l5 5 5-5"/>
      </svg>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="nav-section">
    <div class="nav-group">
      <span class="nav-group-label">Overview</span>
      <a href="/" class={`nav-item ${activePath === '/' ? 'active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        </span>
        <span class="nav-label">Dashboard</span>
      </a>
      <a href="/services" class={`nav-item ${activePath === '/services' || activePath.startsWith('/services') ? 'active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
        </span>
        <span class="nav-label">Services</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Operations</span>
      <a href="/deploy" class={`nav-item ${activePath === '/deploy' ? 'active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.71 1.1-1.18 1.1-1.18l-4.1-4.1s-.47.39-1.18 1.18z"/><path d="M12 15l-3-3 7.61-7.61a2.12 2.12 0 0 1 3 3L12 15z"/></svg>
        </span>
        <span class="nav-label">Deploy</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">System</span>
      <a href="/settings" class={`nav-item ${activePath === '/settings' || activePath.startsWith('/settings') ? 'active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </span>
        <span class="nav-label">Settings</span>
      </a>
      <a href="#" class="nav-item" target="_blank" rel="noreferrer">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <span class="nav-label">Docs</span>
      </a>
    </div>
  </nav>

  <!-- Footer -->
  <div class="sidebar-footer">
    <div class="user-block">
      <div class="user-avatar">O</div>
      <div class="user-info">
        <span class="user-name">Operator</span>
        <span class="user-host" id="sidebarApiHost">127.0.0.1:7878</span>
      </div>
    </div>
    <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</aside>

<script>
  import { getApiBase } from '../lib/api';

  // Show API base in footer
  const hostEl = document.getElementById('sidebarApiHost');
  if (hostEl) {
    try { hostEl.textContent = getApiBase().replace(/^https?:\/\//, '') || '127.0.0.1:7878'; } catch (_) {}
  }

  // Theme toggle
  const toggle = document.getElementById('themeToggle');
  if (toggle) {
    const html = document.documentElement;
    function setTheme(theme: string) {
      html.setAttribute('data-theme', theme);
      localStorage.setItem('russel-theme', theme);
    }
    function getCurrent(): string {
      return html.getAttribute('data-theme') || 'light';
    }
    toggle.addEventListener('click', () => {
      setTheme(getCurrent() === 'dark' ? 'light' : 'dark');
    });
    // Listen for system changes only when no stored preference
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', (e) => {
      if (!localStorage.getItem('russel-theme')) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    });
  }
</script>

<style>
  .sidebar {
    width: 250px;
    background-color: var(--bg-sidebar);
    border-right: 1px solid var(--border-app);
    display: flex;
    flex-direction: column;
    padding: 1rem 0.75rem;
    user-select: none;
    flex-shrink: 0;
    height: 100vh;
    position: sticky;
    top: 0;
  }

  /* Brand */
  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.25rem 0.25rem 0.75rem 0.5rem;
  }

  .brand-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* Workspace selector */
  .workspace-selector {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-card);
    cursor: pointer;
    margin-bottom: 1.25rem;
    background: var(--bg-card);
    transition: border-color 0.15s ease;
  }

  .workspace-selector:hover {
    border-color: var(--border-input);
  }

  .ws-icon {
    color: var(--text-muted);
    display: flex;
  }

  .ws-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .ws-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ws-subtitle {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .ws-chevron {
    color: var(--text-muted);
    display: flex;
  }

  /* Nav */
  .nav-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    overflow-y: auto;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nav-group-label {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.35rem 0.6rem 0.15rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.12s ease;
    border: 1px solid transparent;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background-color: var(--bg-card-hover);
  }

  .nav-item.active {
    color: var(--text-primary);
    background-color: var(--nav-active-bg);
    border-color: var(--nav-active-border);
    box-shadow: var(--nav-active-shadow);
  }

  .nav-item.active .nav-icon {
    color: var(--accent-primary);
  }

  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: color 0.12s ease;
    flex-shrink: 0;
  }

  /* Footer */
  .sidebar-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-app);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .user-block {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--accent-primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .user-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .user-host {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Theme toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-card);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--border-input);
  }

  /* Default: light mode — show moon (switch to dark), hide sun */
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(html[data-theme="dark"]) .icon-moon { display: none; }
  :global(html[data-theme="dark"]) .icon-sun { display: block; }
</style>
