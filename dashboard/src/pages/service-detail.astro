---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import OfflineState from '../components/OfflineState.astro';
import DestroyDialog from '../components/DestroyDialog.astro';

// Static shell only — no build-time control-plane fetch (#306).
// Query ?id= is client-only on static builds; loadDetail() hydrates live data.
---

<Layout title="Service Detail" activePath="/services">
  <div class="breadcrumb">
    <a href="/services" class="back-link">← services</a>
  </div>

  <div id="detailRoot">
    <Header
      title="Loading…"
      subtitle="Service details load in the browser."
    />

    <div class="detail-grid">
      <!-- Overview Panel -->
      <div class="card-panel info-panel">
        <div class="panel-header-row">
          <h2 class="section-title">Overview & Status</h2>
          <span class="badge badge-muted" id="serviceStatusBadge">
            <span class="badge-dot"></span>
            <span id="serviceStatusText">Loading…</span>
          </span>
        </div>

        <div class="stats-grid" id="statsGrid">
          <div class="stat-item">
            <span class="stat-label">Runtime Engine</span>
            <span class="stat-value" id="statRuntime">—</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Port Mappings</span>
            <span class="stat-value mono" id="statPorts">—</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Route (Traefik Host)</span>
            <span class="stat-value mono" id="statRoute">—</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">VM State</span>
            <span class="stat-value mono" id="statVmState">—</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Uptime</span>
            <span class="stat-value" id="statUptime">Loading…</span>
          </div>
        </div>

        <div class="action-bar">
          <button id="btnStop" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="6" y="6" width="12" height="12"/>
            </svg>
            Stop Service
          </button>
          <button id="btnUpdate" class="btn btn-secondary" title="Rebuild from the recorded repo and apply its current Russelfile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            Update Service
          </button>
          <button id="btnDestroy" class="btn btn-danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
            Destroy Service
          </button>
        </div>

        <p class="action-hint">Update rebuilds from the recorded repo and applies its current Russelfile; nothing from the previous deploy is replayed.</p>
        <div id="actionFeedback" class="action-feedback hidden"></div>
      </div>

      <!-- Logs Panel -->
      <div class="card-panel logs-panel">
        <div class="panel-header-row">
          <h2 class="section-title">Instance Logs</h2>
          <div class="log-actions">
            <button id="btnRefreshLogs" class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
              Fetch Logs
            </button>
            <button id="btnClearLogs" class="btn btn-secondary btn-sm">Clear</button>
          </div>
        </div>
        <div class="log-console" id="logConsole">Loading…</div>
      </div>
    </div>

    <noscript><OfflineState message="Service unavailable" /></noscript>
  </div>

  <!-- Deployment History Card -->
  <div class="card-panel" id="deployHistoryCard" style="margin-top: 3rem;">
    <div class="panel-header-row">
      <h2 class="section-title">Generations</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin: -0.75rem 0 0.5rem 0;">Deploy history — <strong>current</strong> is the desired generation (not process liveness). Use Overview above for running/stopped.</p>
    </div>
    <div id="deployHistoryBody">
      <p style="color: var(--text-muted);">Loading deployment history&hellip;</p>
    </div>
  </div>

  <!-- Rollback Confirmation Modal -->
  <div id="rollbackModal" class="modal-overlay hidden">
    <div class="modal-content card-panel">
      <h3 class="modal-title" style="color: var(--accent-amber);">Confirm Rollback</h3>
      <p class="modal-description">
        <span id="rollbackMsg"></span>
        Rollback redeploys the selected generation's recorded repo and config path through the normal pipeline. Clean generations rebuild from their recorded commit. Dirty generations rebuild the source's current contents.
      </p>
      <div class="modal-actions">
        <button id="btnCancelRollback" class="btn btn-secondary">Cancel</button>
        <button id="btnConfirmRollback" class="btn btn-primary">Confirm Rollback</button>
      </div>
    </div>
  </div>

  <DestroyDialog />
</Layout>

<script>
  import { api, escapeHtml, formatUptime, getApiBase, isServiceRunning } from '../lib/api';
  import { renderOfflineState, renderUnauthorizedState } from '../lib/offline_state';
  import { confirmDestroy } from '../lib/destroy_dialog';

  const params = new URLSearchParams(window.location.search);
  const serviceId = params.get('id');

  if (!serviceId) {
    document.getElementById('detailRoot')!.innerHTML = `<div class="card-panel" style="text-align:center;padding:2rem"><p>No service ID provided. <a href="/services">Browse services</a></p></div>`;
  }

  const btnStop = document.getElementById('btnStop');
  const btnUpdate = document.getElementById('btnUpdate');
  const btnDestroy = document.getElementById('btnDestroy');
  const btnRefreshLogs = document.getElementById('btnRefreshLogs');
  const btnClearLogs = document.getElementById('btnClearLogs');
  const logConsole = document.getElementById('logConsole');
  const actionFeedback = document.getElementById('actionFeedback');
  /** Display name for the destroy dialog, set once the detail loads. */
  let serviceLabel: string | undefined;

  function showFeedback(msg: string, isError = false) {
    if (!actionFeedback) return;
    actionFeedback.classList.remove('hidden', 'success', 'error');
    actionFeedback.classList.add(isError ? 'error' : 'success');
    actionFeedback.textContent = msg;
    setTimeout(() => actionFeedback.classList.add('hidden'), 8000);
  }

  async function loadDetail(id: string) {
    const { service, connection } = await api.getServiceDetail(id);
    if (!service) {
      document.getElementById('detailRoot')!.innerHTML = connection === 'unauthorized'
        ? renderUnauthorizedState()
        : renderOfflineState("Service unavailable", getApiBase(), window.location.origin);
      return;
    }
    document.title = `Service: ${service.name || service.id} — Russel Control Plane`;
    const h1 = document.querySelector('.page-title');
    const sub = document.querySelector('.subtitle');
    if (h1) h1.textContent = service.name || service.id;
    if (sub) sub.textContent = `Service ID: ${service.id}`;
    const badge = document.getElementById('serviceStatusBadge');
    const statusText = document.getElementById('serviceStatusText');
    if (badge) {
      badge.className = `badge ${isServiceRunning(service) ? 'badge-running' : 'badge-stopped'}`;
    }
    if (statusText) statusText.textContent = service.status;
    const statRuntime = document.getElementById('statRuntime');
    const statPorts = document.getElementById('statPorts');
    const statRoute = document.getElementById('statRoute');
    const statVmState = document.getElementById('statVmState');
    const statUptime = document.getElementById('statUptime');
    if (statRuntime) statRuntime.textContent = service.runtime === 'microvm' ? 'Cloud-Hypervisor (MicroVM)' : 'Podman (Container)';
    if (statPorts) statPorts.textContent = service.ports || 'None';
    if (statRoute) statRoute.textContent = service.route_host || '—';
    if (statVmState) statVmState.textContent = service.vm_state || 'unknown';
    if (statUptime) statUptime.textContent = formatUptime(service.uptime_seconds);
    serviceLabel = service.name || service.id;
  }

  if (serviceId) {
    loadDetail(serviceId);
  }

  btnStop?.addEventListener('click', async () => {
    if (!serviceId) return;
    btnStop.setAttribute('disabled', 'true');
    const res = await api.stopService(serviceId);
    showFeedback(res.message, !res.success);
    btnStop.removeAttribute('disabled');
    if (res.success) loadDetail(serviceId);
  });

  btnUpdate?.addEventListener('click', async () => {
    if (!serviceId) return;
    btnUpdate.setAttribute('disabled', 'true');
    const res = await api.updateService(serviceId);
    showFeedback(res.message, !res.success);
    btnUpdate.removeAttribute('disabled');
  });

  btnDestroy?.addEventListener('click', async () => {
    if (!serviceId) return;
    if (!(await confirmDestroy(serviceLabel ?? serviceId))) return;
    const res = await api.destroyService(serviceId);
    showFeedback(res.message, !res.success);
    if (res.success) {
      setTimeout(() => { window.location.href = '/services'; }, 1500);
    }
  });

  btnRefreshLogs?.addEventListener('click', async () => {
    if (!serviceId || !logConsole) return;
    logConsole.textContent = 'Fetching logs from Russel control plane...';
    const logs = await api.getServiceLogs(serviceId);
    logConsole.textContent = logs;
    logConsole.scrollTop = logConsole.scrollHeight;
  });

  btnClearLogs?.addEventListener('click', () => {
    if (logConsole) logConsole.textContent = '[Console cleared]';
  });

  // ── Deployment history ──

  const deployBody = document.getElementById('deployHistoryBody');
  const rollbackModal = document.getElementById('rollbackModal');
  const btnCancelRollback = document.getElementById('btnCancelRollback');
  const btnConfirmRollback = document.getElementById('btnConfirmRollback');
  const rollbackMsg = document.getElementById('rollbackMsg');
  let pendingRollbackVersion: number | undefined;

  function formatDeployDate(iso: string): string {
    const d = new Date(iso);
    return d.toLocaleString(undefined, {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  // Generation journal status ≠ process liveness.
  // "active" means current desired generation (may be stopped).
  function deploymentStatusBadge(status: string): string {
    switch (status) {
      case 'active':
        return '<span class="badge badge-info"><span class="badge-dot"></span>current</span>';
      case 'previous':
        return '<span class="badge badge-muted"><span class="badge-dot"></span>previous</span>';
      case 'failed':
        return '<span class="badge badge-stopped"><span class="badge-dot"></span>failed</span>';
      case 'rolled_back':
        return '<span class="badge badge-warning"><span class="badge-dot"></span>rolled back</span>';
      case 'superseded':
      default:
        return '<span class="badge badge-muted">superseded</span>';
    }
  }

  function renderDeployments(rows: any[]): string {
    if (!rows.length) {
      return '<p style="color: var(--text-muted);">No deployment history yet.</p>';
    }
    return `
      <div class="data-table-container" style="margin-top: 0.5rem;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Version</th>
              <th>Status</th>
              <th>Runtime</th>
              <th>Source</th>
              <th>Deployed</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${rows
              .map((d) => {
                const ver = Number(d.version);
                const verSafe = Number.isFinite(ver) ? String(ver) : '0';
                const runtime = escapeHtml(String(d.runtime || '\u2014'));
                const deployed = escapeHtml(formatDeployDate(String(d.deployed_at || '')));
                const source = d.repo_url
                  ? `<span class="mono-text">${escapeHtml(String(d.repo_url))}</span>${
                      d.config_path ? ` <span style="color: var(--text-muted);">${escapeHtml(String(d.config_path))}</span>` : ''
                    }`
                  : '\u2014';
                return `
              <tr>
                <td><strong>v${verSafe}</strong></td>
                <td>${deploymentStatusBadge(String(d.status || ''))}</td>
                <td>${runtime}</td>
                <td>${source}</td>
                <td>${deployed}</td>
                <td>${
                  d.rollback_ready && d.status !== 'active'
                    ? `<button class="btn btn-secondary btn-sm rollback-btn" data-version="${verSafe}">Rollback</button>`
                    : d.status === 'active'
                      ? '<span style="font-size: 0.8rem; color: var(--text-muted);">Desired gen</span>'
                      : '\u2014'
                }</td>
              </tr>`;
              })
              .join('')}
          </tbody>
        </table>
      </div>`;
  }

  async function loadDeployments(id: string) {
    if (!deployBody) return;
    deployBody.innerHTML = '<p style="color: var(--text-muted);">Loading deployment history&hellip;</p>';
    const result = await api.getDeployments(id);
    if (!result.supported) {
      if (result.connection === 'unauthorized') {
        deployBody.innerHTML = renderUnauthorizedState();
      } else if (result.connection === 'offline') {
        deployBody.innerHTML = renderOfflineState('Unavailable while control plane is offline.', getApiBase(), window.location.origin);
      } else {
        deployBody.innerHTML =
          '<p style="color: var(--text-muted);">Deployment history requires russel-ctrl with history API (<a href="https://github.com/daschinmoy21/russel/issues/177">issue #177</a>).</p>';
      }
      return;
    }
    const deployments = result.data?.deployments || [];
    deployBody.innerHTML = renderDeployments(deployments);
    // Bind rollback buttons
    deployBody.querySelectorAll('.rollback-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = parseInt(btn.getAttribute('data-version') || '0', 10);
        pendingRollbackVersion = v;
        if (rollbackMsg) {
          rollbackMsg.innerHTML = `Roll back to <strong>v${v}</strong>?`;
        }
        rollbackModal?.classList.remove('hidden');
      });
    });
  }

  if (serviceId) {
    loadDeployments(serviceId);

    btnCancelRollback?.addEventListener('click', () => {
      rollbackModal?.classList.add('hidden');
    });

    btnConfirmRollback?.addEventListener('click', async () => {
      if (!serviceId) return;
      rollbackModal?.classList.add('hidden');
      const res = await api.rollbackService(serviceId, pendingRollbackVersion);
      if (!res.supported) {
        showFeedback('Rollback not supported by this control plane (issue #177).', true);
        return;
      }
      showFeedback(res.message, !res.success);
      if (res.success) {
        loadDeployments(serviceId);
        loadDetail(serviceId);
      }
    });
  }
</script>

<style>
  .breadcrumb {
    margin-bottom: 1rem;
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .detail-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .panel-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
  }

  .stat-value {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .action-hint {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .stat-value.mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .action-bar {
    display: flex;
    gap: 0.65rem;
    border-top: 1px solid var(--border-card);
    padding-top: 1.25rem;
    flex-wrap: wrap;
  }

  .action-feedback {
    margin-top: 1rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
  }

  .action-feedback.success {
    background-color: var(--bg-badge-success);
    color: var(--accent-green);
    border-left: 1px solid currentColor;
  }

  .action-feedback.error {
    background-color: var(--bg-badge-danger);
    color: var(--accent-red);
    border-left: 1px solid currentColor;
  }

  .log-actions {
    display: flex;
    gap: 0.5rem;
  }
</style>
