---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { isDemoMode } from '../lib/api';
---

<Layout title="Deploy Service" activePath="/deploy">
  <Header
    title="Deploy New Service"
    subtitle="Provision a fresh Cloud-Hypervisor microVM or Podman container workload."
    isDemo={isDemoMode()}
  />

  <div class="deploy-grid">
    <!-- Form Panel -->
    <div class="card-panel form-panel">
      <h2 class="section-title mb-4">Service Configuration</h2>

      <form id="deployForm">
        <div class="form-group">
          <label class="form-label" for="repoUrl">Repository URL</label>
          <input type="text" id="repoUrl" class="form-input" placeholder="https://github.com/my-org/backend" required />
          <span class="field-hint">Git repository URL to clone and deploy.</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="configPath">Config Path</label>
          <input type="text" id="configPath" class="form-input" value="Russelfile.toml" required />
          <span class="field-hint">Path to <code>Russelfile.toml</code> in the repository.</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="runtime">Runtime Engine</label>
            <select id="runtime" class="form-select">
              <option value="">Auto-detect</option>
              <option value="microvm">MicroVM (Cloud-Hypervisor)</option>
              <option value="container">Container (Podman Rootless)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="vmId">VM / Instance ID (Optional)</label>
            <input type="text" id="vmId" class="form-input" placeholder="Auto-generated if blank" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="hostPort">Host Port</label>
            <input type="number" id="hostPort" class="form-input" placeholder="e.g. 8080" min="1" max="65535" />
          </div>

          <div class="form-group">
            <label class="form-label" for="guestPort">Guest Port</label>
            <input type="number" id="guestPort" class="form-input" placeholder="e.g. 3000" min="1" max="65535" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="envVars">Environment Variables (KEY=VALUE per line)</label>
          <textarea id="envVars" class="form-textarea" rows="3" placeholder="DATABASE_URL=postgres://...&#10;PORT=8080"></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" id="btnSubmitDeploy" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.71 1.1-1.18 1.1-1.18l-4.1-4.1s-.47.39-1.18 1.18z"/><path d="M12 15l-3-3 7.61-7.61a2.12 2.12 0 0 1 3 3L12 15z"/>
            </svg>
            Trigger Deployment
          </button>
        </div>
      </form>
    </div>

    <!-- Deployment Terminal Console -->
    <div class="card-panel console-panel">
      <div class="panel-header-row">
        <h2 class="section-title">Deployment Stream Output</h2>
        <span class="badge badge-info" id="streamStatus">Idle</span>
      </div>

      <p class="subtitle mb-3">Live NDJSON stream output from POST <code>/deploy</code> endpoint.</p>
      
      <div class="log-console" id="deployConsole">[Ready] Fill in configuration and click 'Trigger Deployment' to stream build &amp; boot logs...</div>
    </div>
  </div>
</Layout>

<script>
  import { api } from '../lib/api';
  import type { DeployEvent } from '../lib/api';

  const form = document.getElementById('deployForm') as HTMLFormElement | null;
  const deployConsole = document.getElementById('deployConsole');
  const streamStatus = document.getElementById('streamStatus');
  const btnSubmit = document.getElementById('btnSubmitDeploy');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!deployConsole || !streamStatus || !btnSubmit) return;

    btnSubmit.setAttribute('disabled', 'true');
    streamStatus.textContent = 'Deploying...';
    streamStatus.className = 'badge badge-warning';
    deployConsole.textContent = '';

    const repo_url = (document.getElementById('repoUrl') as HTMLInputElement).value.trim();
    const config_path = (document.getElementById('configPath') as HTMLInputElement).value.trim() || 'Russelfile.toml';
    const vm_id = (document.getElementById('vmId') as HTMLInputElement).value.trim() || undefined;
    const runtimeVal = (document.getElementById('runtime') as HTMLSelectElement).value;
    const runtime = (runtimeVal === 'microvm' || runtimeVal === 'container') ? runtimeVal as 'microvm' | 'container' : undefined;
    const hostPortStr = (document.getElementById('hostPort') as HTMLInputElement).value.trim();
    const guestPortStr = (document.getElementById('guestPort') as HTMLInputElement).value.trim();
    const envRaw = (document.getElementById('envVars') as HTMLTextAreaElement).value.trim();

    /** Parse a port field: integer 1–65535, or null if empty/invalid. */
    function parsePortField(raw: string): number | null {
      if (!raw) return null;
      if (!/^\d+$/.test(raw)) return null;
      const n = Number(raw);
      if (!Number.isInteger(n) || n < 1 || n > 65535) return null;
      return n;
    }

    // Port mapping: omit when both empty; both required (and valid) if either is set.
    // Never coerce empty/invalid to 0 (see #285).
    let port: { host: number; guest: number } | undefined;
    if (hostPortStr || guestPortStr) {
      if (!hostPortStr || !guestPortStr) {
        deployConsole.textContent = '[Error] Both host and guest ports are required when either is set (valid range 1–65535).\n';
        streamStatus.textContent = 'Failed';
        streamStatus.className = 'badge badge-stopped';
        btnSubmit.removeAttribute('disabled');
        return;
      }
      const host = parsePortField(hostPortStr);
      const guest = parsePortField(guestPortStr);
      if (host == null || guest == null) {
        deployConsole.textContent = '[Error] Ports must be integers in the range 1–65535.\n';
        streamStatus.textContent = 'Failed';
        streamStatus.className = 'badge badge-stopped';
        btnSubmit.removeAttribute('disabled');
        return;
      }
      port = { host, guest };
    }

    const env: Record<string, string> = {};
    if (envRaw) {
      for (const line of envRaw.split('\n')) {
        const eq = line.indexOf('=');
        if (eq > 0) {
          env[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
        }
      }
    }

    const handleEvent = (ev: DeployEvent) => {
      const ts = new Date().toISOString().slice(11, 19);
      if (ev.type === 'Progress') {
        deployConsole.textContent += `[${ts}] ${ev.payload.phase}: ${ev.payload.description}\n`;
      } else if (ev.type === 'Complete') {
        const p = ev.payload;
        deployConsole.textContent += `[${ts}] COMPLETE: ${p.message} (${p.elapsed_ms}ms, service_id=${p.service_id}, status=${p.status})\n`;
      } else if (ev.type === 'Error') {
        deployConsole.textContent += `[${ts}] ERROR: ${ev.payload}\n`;
      }
      deployConsole.scrollTop = deployConsole.scrollHeight;
    };

    const result = await api.deployService({ repo_url, config_path, vm_id, port, runtime, env }, handleEvent);

    streamStatus.textContent = result.success ? 'Complete' : 'Failed';
    streamStatus.className = result.success ? 'badge badge-running' : 'badge badge-stopped';
    btnSubmit.removeAttribute('disabled');
  });
</script>

<style>
  .deploy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .deploy-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-actions {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .field-hint {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .field-hint code {
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }

  .console-panel {
    display: flex;
    flex-direction: column;
  }

  .console-panel .subtitle code {
    font-family: var(--font-mono);
    color: var(--accent-primary);
    font-size: 0.8rem;
  }

  .panel-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .log-console {
    flex: 1;
    min-height: 380px;
  }
</style>
