---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Settings" activePath="/settings">
  <Header
    title="Control Plane Settings"
    subtitle="Configure API connection, tokens, and demo mode."
  />

  <div class="settings-grid">
    <!-- API Connection Card -->
    <div class="card-panel settings-panel">
      <h2 class="section-title mb-4">Russel API Connection</h2>

      <form id="settingsForm" novalidate>
        <div class="form-group">
          <label class="form-label" for="apiUrl">Control Plane HTTP API Base URL</label>
          <input
            type="text"
            id="apiUrl"
            class="form-input"
            placeholder="/api"
            aria-describedby="apiUrlHint"
            required
          />
          <div class="preset-row" aria-label="API base presets">
            <button type="button" class="btn btn-secondary btn-sm" data-api-preset="/api">Same-origin <code>/api</code></button>
            <button type="button" class="btn btn-secondary btn-sm" data-api-preset="/api" title="Vite proxies /api to the SSH-forwarded local 7878">Tunneled development <code>/api</code></button>
            <button type="button" class="btn btn-secondary btn-sm" id="btnCustomHttps">Custom HTTPS…</button>
          </div>
          <span class="field-hint" id="apiUrlHint">Use <code>/api</code> for same-origin production or tunneled Vite development. The SSH tunnel must be up for tunneled <code>/api</code>. Do not use <code>http://127.0.0.1:7878</code> from <code>bun run dev</code>.</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="apiToken">API Bearer Token (RUSSEL_API_TOKEN)</label>
          <input
            type="password"
            id="apiToken"
            class="form-input"
            placeholder="Leave empty if unconfigured"
          />
          <span class="field-hint">Passed as <code>Authorization: Bearer &lt;token&gt;</code> on HTTP calls. Token storage is tab-scoped <code>sessionStorage</code>; CLI <code>config.toml</code> does not fill the dashboard. Paste the same token as <code>~/.config/russel/env</code>. Enter at runtime only, never via <code>PUBLIC_*</code> env vars.</span>
        </div>

        <div class="demo-toggle-section">
          <div class="demo-toggle-row">
            <div class="demo-toggle-info">
              <span class="demo-toggle-label" id="demoModeLabel">Demo Mode</span>
              <span class="demo-toggle-desc">
                Demo mode loads mock services without contacting russel-ctrl. When off, the dashboard uses the live API; if the daemon is down you will see Offline/empty state.
              </span>
            </div>
            <label class="switch">
              <input type="checkbox" id="demoModeToggle" aria-labelledby="demoModeLabel" />
              <span class="switch-slider"></span>
            </label>
          </div>
        </div>

        <div class="form-actions-row">
          <button type="button" id="btnTestConn" class="btn btn-secondary" aria-busy="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            Test Connection
          </button>
          
          <button type="submit" class="btn btn-primary">
            Save API Settings
          </button>
        </div>

        <div id="settingsToast" class="toast hidden" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
    </div>

    <!-- Reference & Docs -->
    <div class="card-panel info-panel" id="faq">
      <h2 class="section-title mb-4">Reference & FAQ</h2>

      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-q">Topology A: same host</h3>
          <p class="faq-a">Serve the dashboard and a reverse proxy on the same host as russel-ctrl. Use <code>/api</code>; the proxy keeps ctrl on loopback.</p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">Topology B: SSH tunnel and <code>/api</code></h3>
          <p class="faq-a">Run <code>./contrib/install.sh connect &lt;user@host&gt;</code>, then <code>bun run dev</code>. Vite proxies same-origin <code>/api</code> to the forwarded local port, so the browser does not need CORS.</p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">Topology C: HTTPS same-origin</h3>
          <p class="faq-a">In production, serve the dashboard over HTTPS and map same-origin <code>/api/</code> to russel-ctrl through the reverse proxy. Read the <a href="https://russel.mintlify.site/getting-started/installation" target="_blank" rel="noreferrer">install guide</a> for the setup.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import {
    getApiBase,
    getApiToken,
    setApiBase,
    setApiToken,
    setDemoMode,
    isDemoMode,
    validateApiBase,
    apiBaseValidationError,
    assertCleartextTokenOk,
    joinApiUrl,
    classifyConnectionResult,
    connectionResultMessage,
  } from '../lib/api';

  const apiUrlInput = document.getElementById('apiUrl') as HTMLInputElement | null;
  const apiTokenInput = document.getElementById('apiToken') as HTMLInputElement | null;
  const demoModeToggle = document.getElementById('demoModeToggle') as HTMLInputElement | null;
  const form = document.getElementById('settingsForm');
  const btnTest = document.getElementById('btnTestConn');
  const toast = document.getElementById('settingsToast');

  // "" means same-origin root — show "/" so the field is not blank
  if (apiUrlInput) apiUrlInput.value = getApiBase() || '/';
  if (apiTokenInput) apiTokenInput.value = getApiToken() || '';
  if (demoModeToggle) demoModeToggle.checked = isDemoMode();

  function clearUrlValidation() {
    apiUrlInput?.removeAttribute('aria-invalid');
  }

  function showUrlValidation(message: string) {
    apiUrlInput?.setAttribute('aria-invalid', 'true');
    showToast(message, true);
    apiUrlInput?.focus();
  }

  function showToast(msg: string, isError = false) {
    if (!toast) return;
    toast.classList.remove('hidden', 'success', 'error');
    toast.classList.add(isError ? 'error' : 'success');
    toast.textContent = msg;
    setTimeout(() => toast.classList.add('hidden'), 8000);
  }

  // Demo toggle: apply immediately on change
  demoModeToggle?.addEventListener('change', () => {
    setDemoMode(demoModeToggle.checked);
    location.reload();
  });

  apiUrlInput?.addEventListener('input', clearUrlValidation);

  document.querySelectorAll<HTMLButtonElement>('[data-api-preset]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!apiUrlInput) return;
      apiUrlInput.value = button.dataset.apiPreset || '/api';
      clearUrlValidation();
    });
  });

  document.getElementById('btnCustomHttps')?.addEventListener('click', () => {
    apiUrlInput?.focus();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formBaseRaw = (apiUrlInput?.value ?? '').trim();
    const normalized = validateApiBase(formBaseRaw);
    if (normalized === null) {
      showUrlValidation(apiBaseValidationError(formBaseRaw));
      return;
    }
    clearUrlValidation();
    try {
      setApiBase(formBaseRaw);
      if (apiTokenInput) setApiToken(apiTokenInput.value.trim());
      showToast('API settings saved! Reload page to apply.');
    } catch (err: any) {
      showToast(err?.message || 'Invalid API settings.', true);
    }
  });

  btnTest?.addEventListener('click', async () => {
    btnTest.setAttribute('disabled', 'true');
    btnTest.setAttribute('aria-busy', 'true');
    const formBaseRaw = (apiUrlInput?.value ?? '').trim();
    const formToken = (apiTokenInput?.value ?? '').trim() || null;
    const normalized = validateApiBase(formBaseRaw);
    try {
      // Read the form field as shown (no silent fallback to saved base). Empty
      // input must fail validation the same way as submit — not test getApiBase().
      // UI root representation "/" still normalizes via validateApiBase.
      // "" is valid same-origin root — only null is rejection
      if (normalized === null) {
        showUrlValidation(apiBaseValidationError(formBaseRaw));
        return;
      }
      clearUrlValidation();

      // Cleartext Bearer policy against the form URL + form token
      assertCleartextTokenOk(normalized, formToken);

      const headers: Record<string, string> = {};
      if (formToken) headers['Authorization'] = `Bearer ${formToken}`;

      const res = await fetch(joinApiUrl(normalized, '/vms'), {
        headers,
        signal: AbortSignal.timeout(3000),
      });
      const result = classifyConnectionResult(res);
      if (result.kind === 'success') {
        const data = await result.response.json();
        const count = data.services?.length ?? data.vms?.length ?? 0;
        showToast(`Connected! Found ${count} services on the control plane.`);
      } else {
        showToast(connectionResultMessage(result, normalized, window.location.origin), true);
      }
    } catch (e: any) {
      const result = classifyConnectionResult(e);
      showToast(connectionResultMessage(result, normalized ?? formBaseRaw, window.location.origin), true);
    } finally {
      btnTest.removeAttribute('disabled');
      btnTest.setAttribute('aria-busy', 'false');
    }
  });
</script>

<style>
  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  .field-hint {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .field-hint code {
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }

  .preset-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .demo-toggle-section {
    margin-bottom: 1rem;
    padding: 1rem;
    background: transparent;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
  }

  .demo-toggle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .demo-toggle-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .demo-toggle-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .demo-toggle-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Switch toggle */
  .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--border-input);
    border-radius: 0;
    transition: 0.2s ease;
  }

  .switch-slider::before {
    content: "";
    position: absolute;
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: var(--bg-app);
    border-radius: 0;
    transition: 0.2s ease;
  }

  .switch input:checked + .switch-slider {
    background-color: var(--accent-primary);
  }

  .switch input:checked + .switch-slider::before {
    transform: translateX(20px);
  }

  .form-actions-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .toast {
    margin-top: 1rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
  }

  .toast.success {
    background-color: var(--bg-badge-success);
    color: var(--accent-green);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .toast.error {
    background-color: var(--bg-badge-danger);
    color: var(--accent-red);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .faq-q {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .faq-a {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .faq-a code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-primary);
  }

  .faq-a a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .faq-a a:hover {
    text-decoration: underline;
  }
</style>
