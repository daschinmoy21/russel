# systemd system unit for russel-ctrl (non-NixOS).
#
# `sudo ./contrib/install.sh host` installs this at
# /etc/systemd/system/russel-ctrl.service after replacing @RUSSEL_UID@ with the
# uid of the `russel` service account it creates. Same model as
# nix/modules/russel-host.nix: a dedicated, lingering, unprivileged account
# with a subuid/subgid range for rootless Podman, and nothing else.
#
# Defaults: 127.0.0.1:7878, RUSSEL_REQUIRE_AUTH=1, warm pool off,
# /var/lib/russel 0700 owned by russel. The token is in /etc/russel/env
# (root:russel 0640), so members of the `russel` group can `russel login`.
#
# TLS: reverse proxy to 127.0.0.1:7878. Do not expose :7878.
# MicroVMs (experimental) are optional: the installer adds russel to the kvm
# group when /dev/kvm exists; cloud-hypervisor, virtiofsd, and passt must be on
# PATH. No root or capabilities.
# Dashboard: GET / from the same process. Logs: /var/lib/russel/ctrl.log
# (stderr is warnings unless you add --debug to ExecStart).

[Unit]
Description=Russel control plane
Documentation=https://github.com/daschinmoy21/russel
After=network-online.target nix-daemon.service user@@RUSSEL_UID@.service
Wants=network-online.target user@@RUSSEL_UID@.service
# Rootless Podman keeps its runtime state here; the lingering user manager
# creates it.
RequiresMountsFor=/run/user/@RUSSEL_UID@

[Service]
Type=simple
User=russel
Group=russel
ExecStart=/usr/local/bin/russel-ctrl
WorkingDirectory=/var/lib/russel
Environment=RUSSEL_CTRL_ADDR=127.0.0.1:7878
Environment=RUSSEL_REQUIRE_AUTH=1
Environment=RUSSEL_WARM_POOL=0
Environment=RUSSEL_DATA_DIR=/var/lib/russel
Environment=HOME=/var/lib/russel
# A system unit does not read /etc/profile.d, so name the Nix daemon profile
# explicitly: builds run `nix` from here.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/nix/var/nix/profiles/default/bin
# Rootless Podman finds its runtime dir and the user bus through these. ctrl
# still passes --cgroup-manager=cgroupfs: systemd won't move a process out of a
# system unit into the user manager's scopes (#524).
Environment=XDG_RUNTIME_DIR=/run/user/@RUSSEL_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@RUSSEL_UID@/bus
EnvironmentFile=/etc/russel/env
Restart=on-failure
RestartSec=5s
# Rootless Podman needs newuidmap (file caps or setuid).
NoNewPrivileges=no
# No PrivateTmp, ProtectSystem, or ProtectHome. Rootless Podman keeps a pause
# process that holds the account's namespaces and outlives this unit (see
# KillMode). It captures the first ctrl's mount namespace, so a PrivateTmp /tmp
# that systemd deletes on restart breaks every later podman call ("Failed to
# mount empty tmpfs for pivot_root()"), and ProtectSystem pins a read-only view.
# Isolation comes from the unprivileged `russel` account instead (#524).
Delegate=yes
# Workloads (pasta/conmon) are children of this unit. control-group would
# kill them on restart even though ctrl detaches. process kills only ctrl.
KillMode=process

[Install]
WantedBy=multi-user.target
