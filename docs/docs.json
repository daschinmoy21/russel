      {
        "group": "Concepts",
        "pages": ["concepts/architecture", "concepts/runtimes", "concepts/networking", "concepts/lifecycle", "concepts/builds"]
      },
      {
        "group": "Guides",
        "pages": ["guides/vps-one-dev", "guides/tls-reverse-proxy", "guides/traefik-ingress", "guides/env-secrets", "guides/update-rollback", "guides/troubleshooting", "guides/benchmarks"]
      },
      {
        "group": "Reference",
        "pages": ["reference/cli", "reference/api", "reference/russelfile", "reference/environment", "reference/examples"]
      },
      {
        "group": "Security",
        "pages": ["security/overview", "security/nix-builds"]
      },
      {
        "group": "Operations",
        "pages": ["operations/systemd-nixos", "operations/upgrades-backup"]
      },
      {
        "group": "Project",
        "pages": ["project/development", "project/releases", "project/features/v0.1"]
      }
    ]
  },
  "redirects": [
    { "source": "/architecture", "destination": "/concepts/architecture" },
    { "source": "/auto-generation", "destination": "/concepts/builds" },
    { "source": "/deployment", "destination": "/getting-started/first-deploy" },
    { "source": "/examples", "destination": "/reference/examples" },
    { "source": "/install", "destination": "/getting-started/installation" },
    { "source": "/russelfile", "destination": "/reference/russelfile" },
    { "source": "/security-tls", "destination": "/guides/tls-reverse-proxy" },
    { "source": "/traefik", "destination": "/guides/traefik-ingress" },
    { "source": "/vps-one-dev", "destination": "/guides/vps-one-dev" }
  ]
}
